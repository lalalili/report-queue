{
    "name": "lalalili/report-queue",
    "description": "Asynchronous export job queue with a 24-hour download centre for Laravel + Filament hosts.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "filament/actions": "^4.0 || ^5.0",
        "filament/filament": "^4.0 || ^5.0",
        "filament/notifications": "^4.0 || ^5.0",
        "filament/schemas": "^4.0 || ^5.0",
        "filament/support": "^4.0 || ^5.0",
        "filament/tables": "^4.0 || ^5.0",
        "illuminate/bus": "^12.0 || ^13.0",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/filesystem": "^12.0 || ^13.0",
        "illuminate/queue": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "maatwebsite/excel": "^3.1",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-livewire": "^5.0",
        "pestphp/pest-plugin-phpstan": "^5.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^13.0"
    },
    "suggest": {
        "maatwebsite/excel": "Required only when registering export handlers through ReportExportRegistry::registerExcel()."
    },
    "autoload": {
        "psr-4": {
            "Lalalili\\ReportQueue\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lalalili\\ReportQueue\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Lalalili\\ReportQueue\\ReportQueueServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "scripts": {
        "test": "pest --compact",
        "analyse": "phpstan analyse --configuration=phpstan.neon.dist --no-progress",
        "format": "pint"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    }
}
